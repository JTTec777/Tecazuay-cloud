# ============================================
# .htaccess - Configuración de seguridad y URLs amigables
# ============================================

# ============================================
# OCULTAR INFORMACIÓN DEL SERVIDOR
# ============================================
ServerSignature Off
ServerTokens Prod
Options -Indexes

# ============================================
# REDIRIGIR ERRORES 404 AL INDEX
# ============================================
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php

# ============================================
# REESCRIBIR URLs (para que todo vaya a index.php si no existe)
# ============================================
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # Si el archivo o carpeta no existe, redirige a index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [L]
</IfModule>

# ============================================
# BLOQUEAR ACCESO A ARCHIVOS SENSIBLES
# ============================================
<FilesMatch "\.(env|config|log|ini|sql|git|json|lock|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ============================================
# PROTEGER CARPETAS SENSIBLES
# ============================================
<DirectoryMatch "/(includes|vendor|uploads|storage)/">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>

# ============================================
# SEGURIDAD ADICIONAL PARA .htaccess
# ============================================
<Files ".htaccess">
    Order Allow,Deny
    Deny from all
</Files>
