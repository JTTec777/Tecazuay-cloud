ErrorDocument 404 /index.php
Options -Indexes

# ============================================
# BLOQUEAR ACCESO A ARCHIVOS SENSIBLES
# ============================================
<FilesMatch "\.(env|config|log|ini|sql|git|json|lock|md)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger carpetas
<DirectoryMatch "/(includes|vendor|uploads|storage)/">
    Order Allow,Deny
    Deny from all
</DirectoryMatch>
