# ============================================
# SEGURIDAD
# ============================================

# 1. Bloquear listado de directorios
Options -Indexes

# 2. Archivo por defecto
DirectoryIndex index.php

# 3. Bloquear acceso directo a config.php
<Files "config.php">
    Require all denied
</Files>

# ============================================
# REDIRECCIÓN DE ERRORES A INDEX.PHP
# ============================================

ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
ErrorDocument 500 /index.php

# ============================================
# REESCRITURA: Cualquier URL inexistente → index.php
# ============================================
RewriteEngine On

# Si no es un archivo real...
RewriteCond %{REQUEST_FILENAME} !-f
# ...y no es un directorio real...
RewriteCond %{REQUEST_FILENAME} !-d
# ...redirige todo a index.php
RewriteRule ^(.*)$ /index.php [L,R=302]

# ============================================
# HEADERS DE SEGURIDAD
# ============================================
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
