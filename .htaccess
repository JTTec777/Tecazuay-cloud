# ============================================
# SEGURIDAD BÁSICA
# ============================================

Options -Indexes
DirectoryIndex index.php

# Bloquear acceso directo a config.php
<Files "config.php">
    Require all denied
</Files>

# ============================================
# REESCRITURA INTERNA (sin redirección visible)
# ============================================
RewriteEngine On

# Si NO es un archivo real...
RewriteCond %{REQUEST_FILENAME} !-f
# ...y NO es un directorio real...
RewriteCond %{REQUEST_FILENAME} !-d
# ...sirve index.php internamente (la URL no cambia en el navegador)
RewriteRule ^ /index.php [L]

# ============================================
# ERRORES: solo 404, NO tocar 403 (lo maneja el WAF)
# ============================================
ErrorDocument 404 /index.php

# ============================================
# HEADERS DE SEGURIDAD
# ============================================
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
