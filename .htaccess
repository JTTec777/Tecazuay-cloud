# ============================================
# SEGURIDAD BÁSICA
# ============================================

Options -Indexes
DirectoryIndex index.php

# ============================================
# REESCRITURA: Proteger archivos sensibles redirigiéndolos a index.php
# ============================================
RewriteEngine On

# Redirigir internamente config.php → index.php (no se muestra el código)
RewriteRule ^config\.php$ /index.php [L]

# Redirigir internamente .htaccess → index.php
RewriteRule ^\.htaccess$ /index.php [L]

# Si NO es un archivo real y NO es un directorio real, reescribir a index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /index.php [L]

# ============================================
# ERRORES: solo 404, 403 lo maneja el rewrite de arriba
# ============================================
ErrorDocument 404 /index.php

# ============================================
# HEADERS DE SEGURIDAD
# ============================================
<IfModule mod_headers.c>
    Header set X-XSS-Protection "1; mode=block"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set Referrer-Policy "no-referrer-when-downgrade"
</IfModule>
